# Dependencias LLM del motor (configuración segura, sin valores reales)
DEFAULT_STRIX_LLM=cambiar_por_un_modelo_configurado
LLM_API_KEY=cambiar_por_un_secreto_llm
# La BASE del proveedor, no el endpoint: el cliente le añade `/chat/completions` por su cuenta.
# Poner aquí el endpoint completo duplica la ruta y el proveedor responde 404 *dentro* de la
# petición del chat, que es un fallo mucho más difícil de diagnosticar que un error de arranque.
# OpenRouter: https://openrouter.ai/api/v1 · OpenAI: https://api.openai.com/v1
LLM_API_BASE=https://api.openai.com/v1

# --------------------------------------------------------------------------
# Controles de seguridad del runner. Los dos fallan CERRADOS: sin ellos, no hay escaneos.
# --------------------------------------------------------------------------
#
# STRIX_REQUIRE_EGRESS_FENCE (por defecto true)
#   Antes de arrancar cada contenedor, el runner comprueba que hay una regla de iptables en
#   DOCKER-USER que cubra la subred de la red de ese trabajo. Sin ella, el contenedor sale
#   con los permisos de red del host: los metadatos de la nube, la red de Tailscale, Redis y
#   PostgreSQL del despliegue.
#   Instala las reglas con `sudo bash scripts/harden_runner_egress.sh` y ponlo en el ARRANQUE
#   del host, porque las reglas de iptables no sobreviven a un reinicio. En local, false.
STRIX_REQUIRE_EGRESS_FENCE=true
# Rango dentro del cual se espera que caiga la subred de cada trabajo. Lo comprueba la
# validación de arriba; un valor mal escrito hace que la comprobación mire un rango que
# ninguna red va a usar, y pase siempre.
STRIX_NETWORK_POOL=172.31.0.0/16
#
# STRIX_REQUIRE_LLM_KEY_EXPOSURE_ACK (por defecto true)
#   La clave de LLM_API_KEY tiene que entrar en el contenedor: el motor habla con el proveedor
#   por su cuenta, desde dentro, y ese tráfico no pasa por el backend. Pero el contenedor lleva
#   shell, Python y un navegador, y su entrada no es solo el operador: es también el objetivo que
#   se escanea. La credencial es de la PLATAFORMA y da acceso al gasto de todos los clientes.
#
#   Este ajuste no arregla eso: lo que hace es que la exposición sea una decisión declarada y no
#   un accidente. Sin la frase exacta, el runner no arranca. Las tres salidas reales están en
#   backend/workers/runner/llm_key_exposure.py: proxy de inferencia en el worker, credencial con
#   tope por escaneo contra la API de aprovisionamiento, o proxy de salida allowlistado por host.
STRIX_REQUIRE_LLM_KEY_EXPOSURE_ACK=true
STRIX_LLM_KEY_EXPOSURE_ACK=
# En desarrollo, pon las dos de arriba en false para poder lanzar escaneos de prueba.

# Parámetros del chat con agentes (R1: ninguno de estos vive en el código del runner).
# La atribución ante OpenRouter (HTTP-Referer y X-Title) NO se configura: es la identidad
# del producto y está declarada en backend/apps/llm_router/attribution.py.
# Temperatura del asistente. 0 = determinista, como el autofix. Por encima de 1.0 el modelo
# empieza a inventar nombres de funciones y puertos con la misma seguridad con la que acierta.
CHAT_TEMPERATURE=0.4
# Tope de tokens por respuesta. Acota el coste de un paso antes de que lo decida el proveedor.
CHAT_MAX_TOKENS=2048
# Mensajes de historial reenviados al modelo. 0 = sin memoria entre turnos.
CHAT_HISTORY_MESSAGES=12
# Documentos de la base de conocimiento inyectados por paso. 0 = desactiva el RAG.
# Este valor debe coincidir con el de la firma de retrieve_rag_context; hay una prueba que
# los compara, asi que cambiarlo aqui sin cambiarlo alli rompe la suite.
CHAT_CONTEXT_DOCUMENTS=4
# Longitud máxima del texto de un mensaje, en caracteres.
CHAT_MAX_CONTENT_CHARS=16000

# Runner Sandbox Strix
STRIX_SANDBOX_IMAGE=ghcr.io/usestrix/strix-sandbox:latest
# Debe montarse en tmpfs o volumen cifrado efímero en producción (R5).
STRIX_WORKSPACE_ROOT=/tmp/fenix_workspaces
STRIX_NETWORK_PREFIX=strix_net
STRIX_MEMORY_LIMIT=4g
STRIX_CPU_LIMIT=2.0
STRIX_PIDS_LIMIT=256
STRIX_WORKER_CONCURRENCY=1
STRIX_HARD_TIMEOUT_SECONDS=1800
STRIX_SOFT_TIMEOUT_SECONDS=1500
STRIX_WATCHDOG_INTERVAL_SECONDS=300
STRIX_WATCHDOG_STALE_AFTER_SECONDS=1860

# Integraciones Git
GIT_WEBHOOK_MAX_BODY_BYTES=2000000
GIT_WEBHOOK_RATE_LIMIT=120
GIT_WEBHOOK_RATE_WINDOW_SECONDS=60
GIT_WEBHOOK_REPLAY_TTL_SECONDS=86400
GIT_API_TIMEOUT_SECONDS=10
GIT_COMMAND_TIMEOUT_SECONDS=120
GIT_MAX_DIFF_FILES=5000
GIT_MAX_DIFF_PATH_CHARS=512
GIT_ALLOWED_CLONE_HOSTS_CSV=github.com,gitlab.com,bitbucket.org,gitea.com
CHATOPS_REVIEW_COMMANDS=@fenix-team review,@strix review
AUTOFIX_BRANCH_PREFIX=fenix/fix-
AUTOFIX_MAX_FILES=50
AUTOFIX_CREATE_RATE_LIMIT=5
AUTOFIX_CREATE_RATE_WINDOW_SECONDS=60
PR_SCAN_HARD_TIMEOUT_SECONDS=900
PR_SCAN_SOFT_TIMEOUT_SECONDS=840
PR_REVIEW_STALE_AFTER_SECONDS=300
API_PUBLIC_BASE_URL=http://localhost:8000

# --- Entornos y dominios oficiales --------------------------------------------
# Desarrollo local: el frontend corre en 5173 con el proxy de Vite sirviendo /api desde el
# mismo origen, asi que CORS no se usa. En produccion SI se usa, porque la SPA se sirve en
# panel. y la API responde en api., que son origenes distintos por definicion.
#
# En Dokploy (produccion):
#   FRONTEND_BASE_URL=https://panel.mindguardredteam.com
#   API_PUBLIC_BASE_URL=https://api.mindguardredteam.com
#
# CORS_ORIGINS acepta una lista separada por comas. El origen de FRONTEND_BASE_URL se anade
# solo si falta, de modo que un dominio nuevo no obliga a editar dos variables: exigirlo
# produce el peor sintoma posible - el panel carga entero, todas sus peticiones fallan, y
# el error del navegador no menciona CORS -.
#
# En produccion se descartan los origenes con esquema distinto al de la API. Los locales
# quedan muertos pero inocuos, y filtrarlos es preferible a rehusar arrancar.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://panel.mindguardredteam.com,https://mindguardredteam.com
GIT_WEBHOOK_SUBSCRIPTION_EVENTS=pull_request,issue_comment
OAUTH_STATE_TTL_SECONDS=600
REPOSITORY_MANAGEMENT_RATE_LIMIT=60
REPOSITORY_MANAGEMENT_RATE_WINDOW_SECONDS=60
OAUTH_CALLBACK_RATE_LIMIT=30
OAUTH_CALLBACK_RATE_WINDOW_SECONDS=60
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_SCOPES=repo read:user admin:repo_hook
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_AUTHORIZE_URL=https://gitlab.com/oauth/authorize
GITLAB_OAUTH_TOKEN_URL=https://gitlab.com/oauth/token
GITLAB_OAUTH_SCOPES=api read_user read_repository

# Equivalencia de cr��ditos y precio de escaneo (R1: el precio no vive en el c��digo)
# 1 cr��dito = 1,00 USD de precio al cliente, ya con el recargo del modelo aplicado.
# El precio de un escaneo se descuenta por adelantado y la telemetr��a ajusta despu��s
# la diferencia contra la reserva, nunca vuelve a cargar el consumo completo.
# Los importes y las cantidades de los paquetes de recarga viven en `CREDIT_PACKS`,
# en el backend, no aqu��: el panel no puede inventar un paquete que la plataforma
# no tiene declarado.
CREDITS_PER_USD=1.00
SCAN_CREDIT_COST=10
QUICK_SCAN_CREDIT_MULTIPLIER=0.3
CHECKOUT_RATE_LIMIT=10
CHECKOUT_RATE_WINDOW_SECONDS=60

# Stripe (scaffolding; sin credenciales reales en el repositorio)
# El webhook valida la firma HMAC contra este secreto, con una tolerancia de 300 s.
# Dejar vac��o en desarrollo permite arrancar sin claves; staging y producci��n fallan.
# `STRIPE_PUBLISHABLE_KEY` debe empezar por `pk_` si se rellena; el prefijo es lo
# que distingue una clave publicable de una secreta por error de configuraci��n.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Cat��logo CVE de referencia (p��blico, no multi-tenant)
# Las URLs apuntan a los feeds oficiales: CVE de CIRCL/NVD y cat��logo KEV de CISA.
# La sincronizaci��n corre en Celery beat y es incremental por `published_at`.
CVE_QUERY_RATE_LIMIT=120
CVE_QUERY_RATE_WINDOW_SECONDS=60
CVE_SYNC_INTERVAL_HOURS=12
CVE_SYNC_HTTP_TIMEOUT_SECONDS=30
CVE_NVD_FEED_URL=https://cve.circl.lu/api/last
CVE_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Descubrimiento de superficie de ataque ---------------------------------------
# Tope de espera de cada consulta DNS, en segundos. Es una politica operativa: cuanto
# espera el panel a un DNS lento. Subirlo da margen a resolvers lentos a cambio de dejar
# un worker ocupado durante la espera.
ASSET_DISCOVERY_DNS_TIMEOUT_SECONDS=4
# Consultas DNS simultaneas. Sube mas consultas a la vez no acelera el descubrimiento: los
# resolvers publicos cortan por origen, asi que un valor alto produce timeouts en vez de
# resultados. El tope blando de Celery es de 2100 s; por encima de unos 128 candidatos la
# tarea lo alcanzaria antes de terminar.
ASSET_DISCOVERY_DNS_CONCURRENCY=24
# Cuantos prefijos se prueban como maximo por ejecucion. El recorte conserva el ORDEN de
# esta lista, no uno aleatorio: lo que se escriba primero es lo que se prueba primero, y
# por eso el orden es el de prioridad.
ASSET_DISCOVERY_MAX_CANDIDATES=64
# Tope de activos que guarda una ejecucion. Es una CUOTA de escaneo, no un detalle: lo que
# se pasa de aqui se recoge en la siguiente ejecucion, que actualiza `last_scanned_at` de
# lo que ya conhece. Evita que un dominio con miles de nombres bloquee filas en una sola
# transaccion.
ASSET_DISCOVERY_MAX_ASSETS=500
# Lista de prefijos de subdominio a probar, separada por comas. Se normaliza a minusculas
# y se eliminan repetidos y vacios. Es un campo de despliegue y NO un parametro de la
# peticion, a proposito: si el cliente pudiera enviarla, este endpoint seria un vector de
# enumeracion con el tamano de la lista como control.
ASSET_DISCOVERY_WORDLIST=www,api,app,admin,portal,intranet,staging,stage,dev,test,qa,uat,prod,beta,internal,git,gitlab,jenkins,ci,cdn,static,assets,mail,smtp,imap,webmail,vpn,remote,ssh,ftp,db,database,sql,grafana,kibana,prometheus,metrics,status,health,auth,sso,oauth,login,accounts,account,billing,payment,payments,shop,store,blog,docs,wiki,help,support,ticket,chat,forum,news,media,img,images,files,download,downloads,backup,backups,old,new,preprod,sandbox,lab,lab1,dev1,dev2,node1,vm,esx,proxy,gateway
