# Entorno de aplicación
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=cambiar_por_un_secreto_aleatorio_de_al_menos_32_caracteres

# PostgreSQL remoto (Dokploy vía Tailscale)
DB_HOST=100.89.59.70
DB_PORT=5433
DB_NAME=fenix_team_db
