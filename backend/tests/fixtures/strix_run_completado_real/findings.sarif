        {
          "ruleId": "strix-coverage/live-service-fingerprinting-hidden-paths-api-auth-surface-discovery",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Live-service fingerprinting, hidden paths, API/auth surface discovery — No issue identified: https://mindguard.site (static SPA root + asset bundle)\n\nFingerprinted via httpx/curl/wafw00f; katana+gospider crawl, dirsearch common-list (~2.7k paths), manual verification of admin/api/.env/.git paths. Site is a static React marketing SPA on Hostinger CDN with no backend, no API, no auth; 403s were CDN anti-bot challenge pages and 502s Hostinger 404 pages, not real access control."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "https://mindguard.site (static SPA root + asset bundle)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Live-service fingerprinting, hidden paths, API/auth surface discovery",
              "surface": "https://mindguard.site (static SPA root + asset bundle)",
              "recorded_by": "Recon Agent - mindguard.site",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/hardcoded-secrets-hidden-api-routes-parameter-names-in-client-js",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Hardcoded secrets, hidden API routes, parameter names in client JS — No issue identified: mindguard.site JS bundle /assets/index-B22VnECO.js\n\nFull beautified review of 209 KB bundle (grep + js-beautify): no API endpoints, keys, tokens, auth strings, or user roles. Only 3rd-party integrations are Google Fonts and Cal.com embed (calLink shyntai/1hora, public by design)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "mindguard.site JS bundle /assets/index-B22VnECO.js"
