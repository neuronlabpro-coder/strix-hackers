        {
          "ruleId": "strix-coverage/php-contact-handler-email-header-injection-spam-relay-rate-limiting",
          "ruleIndex": 2,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "PHP contact handler — email header injection / spam relay / rate limiting — Requires further review: https://mindguardredteam.com/contact.php\n\nConfirmed live unauthenticated PHP backend: POST accepts form fields name/email/company/service/message with honeypot 'website'; GET returns method-not-allowed JSON. Recon-only mandate — no payload testing performed. Injection, relay, and rate-limit posture unverified; this is the only real dynamic attack surface found in scope."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "https://mindguardredteam.com/contact.php"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "PHP contact handler — email header injection / spam relay / rate limiting",
              "surface": "https://mindguardredteam.com/contact.php",
              "recorded_by": "Recon Agent - mindguard.site",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/subdomain-takeover-dangling-dns",
          "ruleIndex": 3,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Subdomain takeover (dangling DNS) — Ruled out: redteam.mindguard.site / www.redteam.mindguard.site DNS records\n\nResolved by follow-up DNS assessment (entries ef9fff/4daaf8): authoritative Hostinger nameservers return NXDOMAIN with zero records (no A/CNAME/NS) for redteam.mindguard.site and www variant, confirmed from 3 public resolvers and direct NS query. A nonexistent DNS label is not claimable — no takeover vulnerability exists; subfinder hits were stale passive-DNS artifacts."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "redteam.mindguard.site / www.redteam.mindguard.site DNS records"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Subdomain takeover (dangling DNS)",
              "surface": "redteam.mindguard.site / www.redteam.mindguard.site DNS records",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/exposed-services-beyond-80-443-wildcard-cert-additional-subdomains",
          "ruleIndex": 4,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Exposed services beyond 80/443, wildcard cert, additional subdomains — No issue identified: mindguard.site DNS / ports / TLS\n\nsubfinder + dig (A/CNAME) + openssl SAN read + naabu top-100 ports: only 80/443 open on CDN edges 185.77.97.104 / 91.108.103.230; TLS cert covers only mindguard.site and www; www CNAMEs to Hostinger CDN. Only subdomains found were www and the dangling redteam records (tracked separately)."
          },
          "locations": [
            {
              "logicalLocations": [
